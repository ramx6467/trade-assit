AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=
# Interactive AI latency bounds (optional; these are the defaults).
# GEMINI_REQUEST_TIMEOUT_MS: per HTTP attempt to Gemini, in milliseconds (default 20000).
# GEMINI_TOTAL_DEADLINE_SECONDS: whole budget for one generation across retries and fallback models (default 30).
GEMINI_REQUEST_TIMEOUT_MS=20000
GEMINI_TOTAL_DEADLINE_SECONDS=30
# AI_VERIFICATION_LIFETIME_SECONDS: how long a genuine successful verification
# (or a genuine successful chat) keeps the assistant reporting VERIFIED
# (default 300 = 5 minutes). After it lapses the state becomes EXPIRED until a
# new real request succeeds; a cached success never masks a later failure.
AI_VERIFICATION_LIFETIME_SECONDS=300
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
DATABASE_URL=sqlite:///./trademind.db
FRONTEND_ORIGIN=http://localhost:5173
LIVE_TRADING_ENABLED=false
PAPER_INITIAL_BALANCE=100000
PAPER_MAX_RISK_PERCENT=1.0
PAPER_MIN_RR=1.5
PAPER_FEE_RATE=0
PAPER_SLIPPAGE_BPS=0.5

# --- Market data (single instrument: XAUUSD / gold) --------------------------
# TradeMind AI serves exactly one instrument: XAUUSD (XAU/USD — Gold).
#
# The default provider is xaus.com (XAUS), which is keyless:
#   INTERNATIONAL_DATA_PROVIDER=xaus    # no API key required (default)
# Other international providers remain selectable:
#   INTERNATIONAL_DATA_PROVIDER=gold         # goldprice.dev; needs a ga_live_ key
#   INTERNATIONAL_DATA_PROVIDER=twelvedata   # needs INTERNATIONAL_DATA_API_KEY
#   INTERNATIONAL_DATA_PROVIDER=sifting      # needs SIFTING_API_KEY or the above
# Leave the provider blank to run on the synthetic DEMO feed.
#
# xaus.com timeframes served (all free, no plan gating):
#   1m, 3m, 5m, 15m, 30m, 1h, 2h, 4h, 1d
# Native OHLCV: 1m, 5m, 15m, 30m, 1h, 1d. The 3m series is aggregated from 1m
# and 2h/4h from 1h, strictly from real candles (incomplete buckets are dropped,
# never padded). xaus.com publishes no market-hours calendar, so the XAUUSD
# session is reported as SCHEDULE_UNKNOWN (unverified) rather than OPEN/CLOSED,
# and it stays independent of quote freshness.
INTERNATIONAL_DATA_PROVIDER=xaus
INTERNATIONAL_DATA_API_KEY=

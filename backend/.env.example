# AI provider: gemini or openai
AI_PROVIDER=gemini

# Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Fallback models used only when the primary model cannot answer
GEMINI_FALLBACK_MODEL=
GEMINI_FALLBACK_MODELS=
# Interactive AI latency bounds (optional; these are the defaults).
# GEMINI_REQUEST_TIMEOUT_MS: per HTTP attempt to Gemini, in milliseconds (default 20000).
GEMINI_REQUEST_TIMEOUT_MS=20000
# GEMINI_TOTAL_DEADLINE_SECONDS: whole budget for one generation across retries and fallback models (default 30).
GEMINI_TOTAL_DEADLINE_SECONDS=30
# How long a genuine successful verification keeps the assistant reporting VERIFIED (default 300 = 5 minutes).
AI_VERIFICATION_LIFETIME_SECONDS=300

# OpenAI configuration (only used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Database
DATABASE_URL=sqlite:///./trademind.db

# Frontend origin for CORS (restrict in production)
FRONTEND_ORIGIN=http://localhost:5173

# Paper trading
LIVE_TRADING_ENABLED=false
PAPER_INITIAL_BALANCE=100000
PAPER_MAX_RISK_PERCENT=1.0
PAPER_MIN_RR=1.5
PAPER_FEE_RATE=0
PAPER_SLIPPAGE_BPS=0.5

# Market data provider (single instrument: XAUUSD / gold)
# Default xaus.com (XAUS) is keyless: no API key required.
# Other providers need INTERNATIONAL_DATA_API_KEY set.
INTERNATIONAL_DATA_PROVIDER=xaus
INTERNATIONAL_DATA_API_KEY=
